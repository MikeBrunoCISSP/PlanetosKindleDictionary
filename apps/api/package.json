{
  "name": "@planetos/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev": "concurrently -n api,worker -c blue,magenta \"pnpm dev:api\" \"pnpm dev:worker\"",
    "build": "tsc --project tsconfig.build.json",
    "build:worker": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "prisma": "prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@bull-board/api": "^6.5.0",
    "@bull-board/fastify": "^6.5.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/session": "^11.0.0",
    "@fastify/static": "^9.3.0",
    "@node-rs/argon2": "^2.0.0",
    "@planetos/kindle": "workspace:*",
    "@planetos/shared": "workspace:*",
    "@prisma/client": "^6.0.0",
    "bullmq": "^5.34.0",
    "connect-redis": "^8.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.0.0",
    "nodemailer": "^9.0.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.9.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  }
}
