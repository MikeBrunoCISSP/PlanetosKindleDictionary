# Copy to .env and fill in values before running locally.
# Run: cp .env.example .env
#
# STARTUP VALIDATION: unless NODE_ENV is exactly "development" or "test", the
# API and worker validate their configuration at boot and EXIT if anything
# required is missing, weak, or malformed (no localhost fallbacks, no
# placeholder secrets). Keep NODE_ENV=development below for local work.
#
# Tags below indicate how each variable is supplied in a Railway production
# deployment (see infra/railway/README.md):
#   [railway-provided]  wired automatically by .railway/railway.ts - do not set by hand
#   [operator-set]      set as a Railway variable by the operator (secret / env-specific)
#   [local-only]        only relevant for local dev; the prod default is fine

# PostgreSQL connection string (matches infra/docker-compose.yml defaults)
# [railway-provided] from the managed Postgres service
DATABASE_URL=postgresql://planetos:planetos@localhost:5432/planetos

# Redis connection string (matches infra/docker-compose.yml defaults)
# [railway-provided] from the managed Redis service
REDIS_URL=redis://localhost:6379

# Node environment. Must be "development" (or "test") locally so config
# validation stays permissive; Railway sets this to "production", which
# turns on strict validation and flips the session cookie to Secure.
# [railway-provided]
NODE_ENV=development

# HTTP port the API listens on. Railway injects PORT at runtime.
# [railway-provided]
PORT=3000

# Session signing secret - minimum 32 characters, keep secret in production
# [operator-set]
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Settings encryption key (AES-256-GCM) for encrypted-at-rest admin settings
# (e.g. the Turnstile Secret Key) - minimum 32 characters. In production this
# MUST be identical on the app and worker services and must never change.
# [operator-set]
SETTINGS_ENCRYPTION_KEY=change-me-to-a-long-random-string-at-least-32-chars

# MinIO / S3-compatible object storage (matches infra/docker-compose.yml defaults).
# In production these come from `railway bucket credentials` for the Railway bucket.
# [operator-set]
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=dictionaries
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Public origin of the app (used for CORS and email links). In production this
# is the app's own public domain; .railway/railway.ts defaults it to
# https://${{RAILWAY_PUBLIC_DOMAIN}} and the operator overrides it only for a
# custom domain.
# [railway-provided] (operator overrides only for a custom domain)
PUBLIC_BASE_URL=http://localhost:5173

# Transactional email (verification / password reset / account-approved).
# MAIL_TRANSPORT selects how mail is sent:
#   smtp       - Nodemailer over SMTP_URL (local dev -> Mailpit; or a Pro-plan
#                SMTP relay in prod). This is the default.
#   brevo-api  - Brevo's HTTPS API (BREVO_API_KEY). Works on any Railway plan.
# [railway-provided] (.railway/railway.ts sets this to brevo-api in prod)
MAIL_TRANSPORT=smtp

# Sender identity for all outgoing mail. In production MAIL_FROM_ADDRESS must be
# on a domain you have verified in Brevo - not localhost / .local / .test / .example.
# [operator-set]  (MAIL_FROM_NAME defaults to "eReader Dictionaries")
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME=eReader Dictionaries

# Brevo HTTPS API key - required only when MAIL_TRANSPORT=brevo-api.
# Brevo dashboard -> SMTP & API -> API Keys (an api-key, NOT an SMTP key).
# [operator-set]
BREVO_API_KEY=your-brevo-api-key

# SMTP connection URL - required only when MAIL_TRANSPORT=smtp.
# Format: smtp://user:pass@host:port - percent-encode @ : / in the user/password
# (@ -> %40, etc.). Local dev/test points at the Mailpit catcher (see
# infra/docker-compose.yml). For a Pro-plan Brevo relay:
# smtp://<brevo-login>:<brevo-SMTP-key>@smtp-relay.brevo.com:587
# [operator-set]
SMTP_URL=smtp://localhost:1025

# Cron schedule for the hourly dictionary sweep. The default matches production;
# override only for local testing.
# [local-only]
BUILD_CRON=0 * * * *

# Built-in administrator account - created/updated on each `pnpm --filter api seed`
# run (in production: `railway run --service app pnpm --filter @planetos/api seed`,
# once). Password must satisfy: >=8 chars, >=1 uppercase, >=1 lowercase, >=1 digit.
# [operator-set]
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe1!

# Cloudflare Turnstile is NOT an environment variable - an administrator
# configures it in the app (Administration -> Turnstile) after deployment; the
# secret is stored encrypted with SETTINGS_ENCRYPTION_KEY. For local development
# use Cloudflare's published dummy test keys - never commit real values.
#   Always passes:  Site Key 1x00000000000000000000AA / Secret Key 1x0000000000000000000000000000000AA
#   Always blocks:  Site Key 2x00000000000000000000AB / Secret Key 2x0000000000000000000000000000000AA
#   Forces a visible challenge: Site Key 3x00000000000000000000FF
# See https://developers.cloudflare.com/turnstile/troubleshooting/testing/ for the full list.
