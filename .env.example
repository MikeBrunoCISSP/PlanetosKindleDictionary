# Copy to .env and fill in values before running locally.
# Run: cp .env.example .env

# PostgreSQL connection string (matches infra/docker-compose.yml defaults)
DATABASE_URL=postgresql://planetos:planetos@localhost:5432/planetos

# Redis connection string (matches infra/docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# Session signing secret — minimum 32 characters, keep secret in production
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Settings encryption key (AES-256-GCM) for encrypted-at-rest admin settings
# (e.g. Turnstile Secret Key) — minimum 32 characters, keep secret in production
SETTINGS_ENCRYPTION_KEY=change-me-to-a-long-random-string-at-least-32-chars

# MinIO / S3-compatible object storage (matches infra/docker-compose.yml defaults)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=dictionaries
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Base URL of the web frontend (used for CORS and email links)
PUBLIC_BASE_URL=http://localhost:5173

# SMTP connection URL for verification and password-reset emails
# Format: smtp://user:pass@host:port — if the user or password contains
# special characters (e.g. @, :, /), percent-encode them (@ -> %40, etc.)
# Local dev/test default points at the local Mailpit catcher (see
# infra/docker-compose.yml); no credentials needed for that one.
SMTP_URL=smtp://localhost:1025

# Cron schedule for the hourly dictionary sweep (override for local testing)
BUILD_CRON=0 * * * *

# Built-in administrator account — created/updated on each `pnpm --filter api seed` run.
# Password must satisfy complexity rules: ≥8 chars, ≥1 uppercase, ≥1 lowercase, ≥1 digit.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe1!

# Cloudflare Turnstile (Administration → Turnstile in the app).
# For local development, use Cloudflare's published dummy test keys — never
# commit real production Site Key / Secret Key values here or anywhere else.
#   Always passes:  Site Key 1x00000000000000000000AA / Secret Key 1x0000000000000000000000000000000AA
#   Always blocks:  Site Key 2x00000000000000000000AB / Secret Key 2x0000000000000000000000000000000AA
#   Forces a visible challenge: Site Key 3x00000000000000000000FF
# See https://developers.cloudflare.com/turnstile/troubleshooting/testing/ for the full list.
