# Copy to .env and fill in values before running locally.
# Run: cp .env.example .env

# PostgreSQL connection string (matches infra/docker-compose.yml defaults)
DATABASE_URL=postgresql://planetos:planetos@localhost:5432/planetos

# Redis connection string (matches infra/docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# Session signing secret — minimum 32 characters, keep secret in production
SESSION_SECRET=ad6dd969-7602-4ef0-aa54-9e1bc8759801

# Settings encryption key (AES-256-GCM) for encrypted-at-rest admin settings
# (e.g. Turnstile Secret Key) — minimum 32 characters, keep secret in production
SETTINGS_ENCRYPTION_KEY=f3a1c9e2-8b4d-4a7f-9c3e-2d6b5f8a1c4e-7d9b2f6a

# MinIO / S3-compatible object storage (matches infra/docker-compose.yml defaults)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=dictionaries
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Base URL of the web frontend (used for CORS and email links)
PUBLIC_BASE_URL=http://localhost:5173

# SMTP connection URL for verification and password-reset emails
# Format: smtp://user:pass@host:port
SMTP_URL=smtp://localhost:1025

# Cron schedule for the hourly dictionary sweep (override for local testing)
BUILD_CRON=0 * * * *

# Built-in administrator account — created/updated on each `pnpm --filter api seed` run.
# Password must satisfy complexity rules: ≥8 chars, ≥1 uppercase, ≥1 lowercase, ≥1 digit.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=P@ssw0rd1
